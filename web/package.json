{
  "name": "geochannel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run check:bundle",
    "preview": "vite preview --port 5173",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:structure": "node ../scripts/check-structure.mjs --target=web",
    "test:e2e": "playwright test",
    "test:unit": "tsx --test src/features/**/*.test.ts"
  },
  "dependencies": {
    "@geochannel/client": "file:../packages/client",
    "@geochannel/contracts": "file:../packages/contracts",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "h3-js": "^4.1.0",
    "maplibre-gl": "^3.6.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "vite": "^8.0.16"
  }
}
